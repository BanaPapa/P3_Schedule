# 원격 Supabase 프로젝트: 대시보드 Project Settings > API 의 URL·publishable key
# (또는 `pnpm exec supabase link --project-ref <project-ref>` 후 대시보드에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 초대 링크에 쓸 사이트 주소. 비워 두면 요청 헤더에서 계산한다.
NEXT_PUBLIC_SITE_URL=
# AI 도우미(가정통신문 일정 찾기, 지출 분석). 비워 두면 AI 화면은 꺼진다. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다.
ANTHROPIC_API_KEY=
# 테스트 전용 가짜 AI. 운영에서는 절대 설정하지 않는다.
# FAMILY_HUB_FAKE_AI=1
# 로그인 화면 없이 쓰기: 둘 다 채우면 서버가 이 계정으로 자동 로그인한다(서버 전용, NEXT_PUBLIC_ 금지).
# 부부가 이 한 계정을 같이 쓴다. 주소만 알면 누구나 들어올 수 있으니 공개 배포 주소는 남에게 알리지 않는다.
FAMILY_HUB_LOGIN_EMAIL=
FAMILY_HUB_LOGIN_PASSWORD=
