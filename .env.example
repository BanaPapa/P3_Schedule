# 로컬: `pnpm exec supabase status` 의 API_URL, PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 초대 링크에 쓸 사이트 주소. 비워 두면 요청 헤더에서 계산한다.
NEXT_PUBLIC_SITE_URL=
# AI 도우미(가정통신문 일정 찾기, 지출 분석). 비워 두면 AI 화면은 꺼진다. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다.
ANTHROPIC_API_KEY=
# 테스트 전용 가짜 AI. 운영에서는 절대 설정하지 않는다.
# FAMILY_HUB_FAKE_AI=1
